# 抖音数据监控工具 环境变量示例
# 复制为 .env 后填写真实值，切勿提交 .env 到代码仓库

# 服务端口（默认 8888）
PORT=8888

# 飞书应用凭证（可在飞书开放平台创建应用获取）
LARK_APP_ID=cli_xxxxxxxxxxxxxxxx
LARK_APP_SECRET=your_app_secret

# 飞书表格 token（电子表格链接中提取）
LARK_SPREADSHEET_TOKEN=your_spreadsheet_token
LARK_SHEET_ID=0

# 飞书群机器人 webhook（自定义机器人，用于告警推送）
LARK_WEBHOOK=

# 监控默认配置
# LIKE_THRESHOLD=300
# MONITOR_INTERVAL_MINUTES=30
